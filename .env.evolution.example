# ==============================================================================
# EVOLUTION API V2 - ARQUIVO DE CONFIGURAÇÃO (.env) PARA A VPS DEDICADA
# ==============================================================================

# Porta pública exposta na VPS
SERVER_PORT=8080

# URL pública da Evolution API (IP da VPS ou seu domínio com HTTPS se usar Nginx/Traefik)
# Exemplo IP: http://2.25.248.190:8080
# Exemplo Domínio: https://whatsapp.nomedtech.com.br
SERVER_URL=http://2.25.248.190:8080

# Chave mestra de autenticação (deve ser a mesma configurada em EVOLUTION_API_GLOBAL_KEY na Vercel)
AUTHENTICATION_API_KEY=notowhats_secret_key

# Webhook Global apontando para a sua aplicação na Vercel
# A Evolution chamará esse endereço sempre que novas mensagens ou conexões ocorrerem
WEBHOOK_GLOBAL_URL=https://nomedtech.vercel.app/api/webhooks/evolution

# Credenciais do Banco PostgreSQL interno da Evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolutionpass_segura_troque_aqui
POSTGRES_DB=evolution_db
