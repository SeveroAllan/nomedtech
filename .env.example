# ==============================================================================
# NOTOWHATS SAAS - CONFIGURAÇÃO DE AMBIENTE (VPS / LOCAL)
# ==============================================================================

# Supabase (Banco de Dados, Auth, RLS e Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Compatibilidade com projetos que ainda usam a chave anon legada:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# ATENÇÃO: SERVICE ROLE KEY NUNCA DEVE SER EXPOSTA NO CLIENT! Usada apenas em Route Handlers do servidor
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WhatsApp Evolution API v2
EVOLUTION_API_URL=https://evolution.seuservidor.com
EVOLUTION_API_GLOBAL_KEY=your-evolution-global-apikey
# URL que a Evolution consegue acessar para chamar o webhook.
# Local com Evolution em Docker e Next.js no Windows:
# APP_BASE_URL=http://host.docker.internal:3000
# Produção:
APP_BASE_URL=https://seu-dominio.com
# Instância Evolution conectada usada para validar celulares antes da conexão do médico
EVOLUTION_ONBOARDING_INSTANCE_NAME=notowhats_onboarding
# Segredo HMAC usado para proteger os códigos OTP de login via WhatsApp
WHATSAPP_OTP_SECRET=your-long-random-otp-secret

# Focus NFe (Emissão de NFS-e Nacional)
FOCUS_NFE_GLOBAL_TOKEN=your-focus-nfe-token
FOCUS_NFE_ENV=homologacao # ou producao

# Pluggy Open Finance (Validação Pix & Conciliação Bancária)
PLUGGY_CLIENT_ID=your-pluggy-client-id
PLUGGY_CLIENT_SECRET=your-pluggy-client-secret

# Segurança de Webhooks
WEBHOOK_SECRET=your-secure-random-secret

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Integrations (Gmail, Google Drive, Google Agenda)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Consulta Cadastral de CPF (Hub do Desenvolvedor)
HUB_DESENVOLVEDOR_TOKEN=your-hub-token
HUB_DESENVOLVEDOR_URL=https://ws.hubdodesenvolvedor.com.br/v2/cpf/


